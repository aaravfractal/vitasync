# Copy to .env.local. Never commit .env.local.
NEXT_PUBLIC_SITE_URL=https://vitasync.ai
ANTHROPIC_API_KEY=            # server-only; /api/chat falls back to a mock when empty
ANTHROPIC_MODEL=claude-sonnet-4-6

# Step 1 (auth + record spine)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=    # server-only

# Sharing (/u/{token} OTP gate)
SHARE_SECRET=                 # server-only; HMAC key for the OTP + session cookies. REQUIRED in production.
                              # generate with: openssl rand -base64 32

RATE_LIMIT_BYPASS_TOKEN=      # local testing only; a request whose x-vs-bypass header matches
                              # this skips the /api/chat daily cap. Never set it in Vercel.

# Step 5 (sharing)
SMS_PROVIDER=                 # msg91 | twilio ; leave empty for demo codes
SMS_API_KEY=
SMS_DLT_SENDER_ID=            # required in India

# Step 6 (anchoring)
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
ANCHOR_PRIVATE_KEY=           # server-only, testnet wallet
